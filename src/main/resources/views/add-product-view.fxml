<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.onlinesalessystem.controllers.AddProductController"
      spacing="10"
      alignment="CENTER"
      stylesheets="@../styles/style.css"
      style="-fx-padding: 40;">

    <Label text="Shto Produkt"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <TextField fx:id="nameField"
               promptText="Emri i produktit"
               maxWidth="300" />

    <TextArea fx:id="descriptionArea"
              promptText="Pershkrimi"
              maxWidth="300"
              maxHeight="80" />

    <TextField fx:id="priceField"
               promptText="Cmimi"
               maxWidth="300" />

    <TextField fx:id="quantityField"
               promptText="Sasia"
               maxWidth="300" />

    <TextField fx:id="categoryField"
               promptText="Kategoria"
               maxWidth="300" />

    <Button text="Shto Produkt"
            onAction="#handleAddProduct"
            maxWidth="300" />

    <Button text="Kthehu ne Home"
            onAction="#goToHome"
            maxWidth="300" />

    <Label fx:id="messageLabel"
           textFill="red" />
</VBox>